{
  "name": "iobroker.fritzwireguard",
  "version": "0.2.34",
  "description": "ioBroker adapter: WireGuard VPN to a remote FritzBox with optional TR-064 and TCP tunnel manager",
  "author": {
    "name": "MPunktBPunkt",
    "email": "martin@bchmnn.de"
  },
  "contributors": [],
  "homepage": "https://github.com/MPunktBPunkt/ioBroker.fritzwireguard",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "wireguard",
    "fritzbox",
    "vpn",
    "tr-064",
    "network"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MPunktBPunkt/ioBroker.fritzwireguard.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.0.0"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "admin/i18n/",
    "lib/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:package && npm run test:integration",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter"
  },
  "bugs": {
    "url": "https://github.com/MPunktBPunkt/ioBroker.fritzwireguard/issues"
  },
  "readmeFilename": "README.md",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
