{
  "i18n": true,
  "type": "tabs",
  "items": {
    "quickstart": {
      "type": "panel",
      "label": "quickstart",
      "items": {
        "qsHeader": {
          "type": "header",
          "text": "qsHeader",
          "size": 4,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "qsSteps": {
          "type": "staticText",
          "text": "qsSteps",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "subnetWarn": {
          "type": "staticText",
          "text": "subnetWarn",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "statusHeader": {
          "type": "header",
          "text": "statusHeader",
          "size": 4,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "connectionStatus": {
          "type": "textSendTo",
          "label": "connectionStatus",
          "command": "getConnectionStatus",
          "container": "html",
          "alsoDependsOn": [
            "wgConfig",
            "fritzHost",
            "fritzUser",
            "fritzPass",
            "tunnels",
            "autoConnect"
          ],
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "btnTest": {
          "type": "sendTo",
          "command": "testConnection",
          "label": "btnTest",
          "variant": "contained",
          "icon": "play_arrow",
          "showProcess": true,
          "timeout": 45000,
          "result": {
            "ok": "resultOk",
            "partial": "resultPartial",
            "fail": "resultFail"
          },
          "error": {
            "fail": "resultFail"
          },
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "btnWebUI": {
          "type": "sendTo",
          "command": "openWebUI",
          "label": "btnWebUI",
          "variant": "outlined",
          "icon": "web",
          "openUrl": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "webUiHint": {
          "type": "pattern",
          "label": "webUiHint",
          "pattern": "http://<ioBroker-IP>:${data.webPort}/",
          "copyToClipboard": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    },
    "connection": {
      "type": "panel",
      "label": "connection",
      "items": {
        "connHelp": {
          "type": "staticText",
          "text": "connHelp",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "fritzHost": {
          "type": "text",
          "label": "fritzHost",
          "default": "192.168.178.1",
          "help": "fritzHost_help",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "fritzPort": {
          "type": "number",
          "label": "fritzPort",
          "default": 49000,
          "help": "fritzPort_help",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "fritzUser": {
          "type": "text",
          "label": "fritzUser",
          "help": "fritzUser_help",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "fritzPass": {
          "type": "password",
          "label": "fritzPass",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "webPort": {
          "type": "number",
          "label": "webPort",
          "default": 8094,
          "help": "webPort_help",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "pollInterval": {
          "type": "number",
          "label": "pollInterval",
          "default": 60,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        }
      }
    },
    "wireguard": {
      "type": "panel",
      "label": "wireguard",
      "items": {
        "wgHelp": {
          "type": "staticText",
          "text": "wgHelp",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "wgConfig": {
          "type": "text",
          "label": "wgConfig",
          "help": "wgConfig_help",
          "minRows": 12,
          "maxRows": 24,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "autoConnect": {
          "type": "checkbox",
          "label": "autoConnect",
          "default": true,
          "help": "autoConnect_help",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "autoReconnect": {
          "type": "checkbox",
          "label": "autoReconnect",
          "default": true,
          "help": "autoReconnect_help",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "wgDisconnectOnStop": {
          "type": "checkbox",
          "label": "wgDisconnectOnStop",
          "default": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    },
    "tunnels": {
      "type": "panel",
      "label": "tunnels",
      "items": {
        "tunnelHelp": {
          "type": "staticText",
          "text": "tunnelHelp",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "tunnels": {
          "type": "table",
          "label": "tunnelsTable",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "items": [
            {
              "attr": "name",
              "type": "text",
              "title": "tunnelName",
              "width": "22%"
            },
            {
              "attr": "localPort",
              "type": "number",
              "title": "localPort",
              "width": "15%"
            },
            {
              "attr": "remoteHost",
              "type": "text",
              "title": "remoteHost",
              "width": "28%"
            },
            {
              "attr": "remotePort",
              "type": "number",
              "title": "remotePort",
              "width": "15%"
            },
            {
              "attr": "enabled",
              "type": "checkbox",
              "title": "enabled",
              "width": "10%"
            }
          ]
        },
        "tunnelRestartHint": {
          "type": "staticText",
          "text": "tunnelRestartHint",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    },
    "advanced": {
      "type": "panel",
      "label": "advanced",
      "items": {
        "logBuffer": {
          "type": "number",
          "label": "logBuffer",
          "default": 500,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        }
      }
    }
  }
}
